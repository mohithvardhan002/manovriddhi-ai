# Manovriddhi AI — Backend Configuration
# Copy this file to .env and configure your keys if available.
# The platform functions smoothly in offline/demo mode without any API keys!

# Gemini API Key (optional for live AI answers, Vision & translation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq API Key (optional fallback provider)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Minimum BM25 retrieval score threshold for textbook grounding
MIN_SCORE=0.5

# Server Port
PORT=8000
HOST=127.0.0.1

# Environment (development / production)
ENV=development
